{
    "name": "unitas",
    "version": "0.0.0",
    "keywords": [],
    "license": "MIT",
    "author": {
        "name": "Oleg Kamlowski",
        "email": "oleg.kamlowski@thomann.io"
    },
    "files": [
        "src",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./combinators": {
            "import": {
                "types": "./dist/combinators.d.mts",
                "default": "./dist/combinators.mjs"
            },
            "require": {
                "types": "./dist/combinators.d.cts",
                "default": "./dist/combinators.cjs"
            }
        },
        "./utils": {
            "import": {
                "types": "./dist/utils.d.mts",
                "default": "./dist/utils.mjs"
            },
            "require": {
                "types": "./dist/utils.d.cts",
                "default": "./dist/utils.cjs"
            }
        },
        "./terminals": {
            "import": {
                "types": "./dist/terminals.d.mts",
                "default": "./dist/terminals.mjs"
            },
            "require": {
                "types": "./dist/terminals.d.cts",
                "default": "./dist/terminals.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "watch": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:types": "attw --pack .",
        "test:extract": "tsx bin/extract-examples.mjs && oxfmt ./test/examples.test.ts",
        "coverage": "vitest run --coverage",
        "format": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fix:index": "tsx bin/generate-index.mjs",
        "fix:imports": "npx jscodeshift -t bin/split-imports.mjs src --extensions=ts --parser=tsx"
    },
    "devDependencies": {
        "@types/node": "^25",
        "@vitest/coverage-istanbul": "^4.0.16",
        "@vitest/coverage-v8": "^4",
        "jscodeshift": "^17",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.56.0",
        "tsdown": "^0.21",
        "tsx": "^4",
        "typescript": "^5",
        "vitest": "^4"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.8.0"
    }
}
