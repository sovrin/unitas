{
    "name": "unitas",
    "version": "0.2.4",
    "keywords": [
        "combinator",
        "functional",
        "parser"
    ],
    "license": "MIT",
    "author": {
        "name": "Oleg Kamlowski",
        "email": "oleg.kamlowski@thomann.io"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sovrin/unitas.git"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./combinators": {
            "import": {
                "types": "./dist/combinators.d.mts",
                "default": "./dist/combinators.mjs"
            }
        },
        "./terminals": {
            "import": {
                "types": "./dist/terminals.d.mts",
                "default": "./dist/terminals.mjs"
            }
        },
        "./primitives": {
            "import": {
                "types": "./dist/primitives.d.mts",
                "default": "./dist/primitives.mjs"
            }
        },
        "./utils": {
            "import": {
                "types": "./dist/utils.d.mts",
                "default": "./dist/utils.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "watch": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:types": "attw --pack .",
        "test:extract": "tsx bin/extract-examples.mjs && oxfmt ./test/examples.test.ts",
        "generate:index": "tsx bin/generate-index.mjs",
        "generate:readme": "tsx bin/generate-readme.mjs && oxfmt ./README.md",
        "coverage": "vitest run --coverage",
        "format": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fix:imports": "npx jscodeshift -t bin/split-imports.mjs src --extensions=ts --parser=tsx"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18",
        "@types/node": "^25",
        "@vitest/coverage-istanbul": "^4.1.5",
        "@vitest/coverage-v8": "^4",
        "jscodeshift": "^17",
        "oxfmt": "^0.47",
        "oxlint": "^1.62",
        "tsdown": "^0.21",
        "tsx": "^4",
        "typescript": "^5",
        "vitest": "^4"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.6.0"
    }
}
